{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "bunVersion": "1.3.14",
  "installCommand": "rustup target add wasm32-unknown-unknown && cargo install wasm-bindgen-cli --version 0.2.128 --locked && bun install --cwd web --frozen-lockfile",
  "buildCommand": "./scripts/build-wasm.sh && bun run --cwd web build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((lessons(/.*)?|tower-vs-alpenglow|protocols)\\.html|index\\.html|sitemap\\.xml|robots\\.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
